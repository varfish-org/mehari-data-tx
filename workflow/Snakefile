from snakemake.utils import validate, min_version

min_version("9.19.0")


configfile: "config/config.yaml"


validate(config, schema="schemas/config.schema.yaml")


wildcard_constraints:
    assembly=r"(GRCh37|GRCh38)",
    source=r"(ensembl-\d+|refseq-[\w.]+)",
    ensembl_release=r"\d+",
    refseq_release=r"[\w.]+",
    mane_release=r"\d+(\.\d+)*",


include: "rules/common.smk"
include: "rules/download.smk"
include: "rules/cdot.smk"
include: "rules/seqrepo.smk"
include: "rules/mehari.smk"
include: "rules/validate.smk"


rule all:
    input:
        "results/all.completed",


rule collect_results:
    input:
        expand(
            [
                "results/{alias}/mehari/seqrepo/txs.bin.zst",
                "results/{alias}/mehari/seqrepo/txs.bin.zst.sha256",
                "results/{alias}/mehari/seqrepo/txs.bin.zst.report.jsonl",
                "results/{alias}/mehari/seqrepo/txs.bin.zst.report.jsonl.sha256",
                # "results/{alias}/mehari/seqrepo/txs.bin.zst.discards.tsv",
                "results/{alias}/mehari/seqrepo/report/mehari_db_check.txt",
            ],
            alias=all_aliases(),
        ),
        expand(
            [
                "results/{alias}/mehari/seqrepo/txs.bin.zst",
                "results/{alias}/mehari/seqrepo/txs.bin.zst.sha256",
            ],
            alias=[merged_alias(assembly) for assembly in config["reference"]],
        ),
    output:
        touch("results/all.completed"),


# lists the databases for the CI build matrix
rule list_aliases:
    output:
        "results/aliases.json",
    localrule: True
    params:
        build=all_aliases(),
        merge=[
            {
                "alias": merged_alias(assembly),
                "ensembl": newest_alias(assembly, "ensembl"),
                "refseq": newest_alias(assembly, "refseq"),
            }
            for assembly in config["reference"]
        ],
    run:
        import json

        with open(output[0], "w") as file:
            json.dump(
                {"build": params.build, "merge": params.merge}, file, indent=2
            )
